# ==============================================================================
# DietGuru / GemBot — Root & Backend Environment Template
# Copy this file to .env in the project root or backend/ and fill in the values.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Supabase Configuration ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_CONNECTION_STRING=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- LLM Providers ---
# Groq is used by default (llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Google Gemini fallback (gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Coach System Prompt Persona
SYSTEM_PROMPT="You are GemBot, an empathetic and highly knowledgeable AI skin and diet coach. You specialize in guiding users on how nutrition, gut health, hydration, and lifestyle directly influence skin clarity and wellness."

# --- RevenueCat (In-App Subscriptions & Webhooks) ---
# Found in: RevenueCat Dashboard -> Project Settings -> API Keys (Secret Key)
REVENUECAT_API_KEY=your_revenuecat_secret_api_key
# Found in: RevenueCat Dashboard -> Integrations -> Webhooks -> Authorization header / secret
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# --- Monitoring & Observability ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
APP_ENV=development

# --- Auth & OAuth Redirects ---
OAUTH_REDIRECT_URL=gembot://oauth/callback
