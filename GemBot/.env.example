# ==============================================================================
# GemBot (React Native / Expo Frontend) Environment Template
# Copy this file to GemBot/.env and configure with your service endpoints.
# All EXPO_PUBLIC_* variables are bundled into the client build.
# ==============================================================================

# --- Supabase Client (Mobile App) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_SUPABASE_CONNECTION_STRING=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# --- Backend API Endpoint ---
# For Android Emulator: use http://10.0.2.2:8000
# For Physical Device: use your local IP e.g. http://192.168.1.xxx:8000 or ngrok HTTPS URL
# For iOS Simulator: use http://localhost:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# --- OAuth & Deep Linking ---
EXPO_PUBLIC_OAUTH_REDIRECT_URL=gembot://oauth/callback

# --- RevenueCat (Public In-App Purchases SDK Key) ---
# Android public key starts with 'goog_', iOS public key starts with 'appl_'
EXPO_PUBLIC_REVENUECAT_API_KEY=goog_your_revenuecat_public_key

# Product IDs matching your Google Play Console / App Store Connect in-app products
EXPO_PUBLIC_REVENUECAT_MONTHLY_PRODUCT_ID=gembot_monthly_sub
EXPO_PUBLIC_REVENUECAT_YEARLY_PRODUCT_ID=gembot_yearly_sub
EXPO_PUBLIC_REVENUECAT_LIFETIME_PRODUCT_ID=gembot_lifetime_access

# --- Crash Reporting ---
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
